import os
import tempfile


class InvalidRecord(Exception):
    pass


def parse_line(line):
    parts = line.strip().split(",")

    if len(parts) != 3:
        raise InvalidRecord(
            f"expected 3 fields, found {len(parts)}"
        )

    if parts[2] not in ("P", "A"):
        raise InvalidRecord(
            f"invalid status '{parts[2]}'"
        )

    return tuple(parts)


def summarise(path):
    present = 0
    absent = 0
    errors = []

    try:
        with open(path, "r", encoding="utf-8") as f:

            for line_no, line in enumerate(f, start=1):
                if not line.strip():
                    continue

                try:
                    reg, date, status = parse_line(line)

                    if status == "P":
                        present += 1
                    else:
                        absent += 1

                except InvalidRecord as e:
                    errors.append((line_no, str(e)))

    except FileNotFoundError as e:
        raise RuntimeError("File not found") from e

    except PermissionError:
        print("Permission denied")

    else:
        print("File read successfully")

    finally:
        print("Processing finished")

    return present, absent, errors


if __name__ == "__main__":

    data = (
        "192311001,2026-10-08,P\n"
        "192311002,2026-10-08,A\n"
        "192311003,2026-10-08\n"
        "192311004,2026-10-08,L\n"
    )

    with tempfile.NamedTemporaryFile(
        "w", suffix=".csv",
        delete=False, encoding="utf-8"
    ) as tmp:

        tmp.write(data)
        filename = tmp.name

    try:
        print(summarise(filename))

    finally:
        os.remove(filename)
